# ==========================================
# Xrock Cybersecurity Publication - Environment Variables
# ==========================================

# 1. Sanity CMS Content Lake & Image CDN
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01
SANITY_API_READ_TOKEN=your_sanity_read_token

# 2. Newsletter (Brevo API)
BREVO_API_KEY=your_brevo_api_key
BREVO_NEWSLETTER_LIST_ID=your_list_id

# 3. Analytics & SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://xrock-security.com

# 4. Optional Database (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/xrock_db

