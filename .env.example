# ==========================================
# AXROK Frontend (Next.js) - Vercel Environment Variables
# ==========================================

# 1. MongoDB Database Connection (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/axrok?retryWrites=true&w=majority

# 2. Authentication Secret (for JWT cookies and admin session verification)
JWT_SECRET=your_super_secure_jwt_secret_cyber_2026_key

# 3. Optional Separate Backend API URL
# When your Express backend is deployed to Render, Railway, or VPS, set this:
# NEXT_PUBLIC_BACKEND_URL=https://axrok-api.onrender.com
# BACKEND_URL=https://axrok-api.onrender.com

# 4. Cloudinary (for Media and Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Brevo Newsletter Integration
BREVO_API_KEY=your_brevo_api_key
BREVO_NEWSLETTER_LIST_ID=your_list_id

# 6. Site URL and Canonical Metadata
NEXT_PUBLIC_SITE_URL=https://your-axrok.vercel.app
